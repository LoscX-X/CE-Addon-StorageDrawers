+package ac.grim.grimac.platform.bukkit.compatibility.craftengine;
+
+import ac.grim.grimac.platform.api.player.BlockTranslator;
+import net.momirealms.craftengine.bukkit.api.CraftEngineBlocks;
+import net.momirealms.craftengine.bukkit.api.event.CraftEngineReloadEvent;
+import net.momirealms.craftengine.bukkit.util.BlockStateUtils;
+import org.bukkit.event.EventHandler;
+import org.bukkit.event.HandlerList;
+import org.bukkit.event.Listener;
+import org.bukkit.event.server.PluginDisableEvent;
+import org.bukkit.plugin.java.JavaPlugin;
+
+import java.util.Arrays;
+
+/** Resolve CE's injected server IDs to the vanilla appearance actually sent to clients.
+ * Packet threads only read an immutable array; no Bukkit world access or registry mutation. */
+public final class CraftEngineBlockTranslator implements BlockTranslator, Listener, AutoCloseable {
+    private record Mapping(int firstCustomId, int[] clientIds) {}
+    private static final Mapping EMPTY = new Mapping(Integer.MAX_VALUE, new int[0]);
+    private final JavaPlugin plugin;
+    private volatile Mapping mapping = EMPTY;
+
+    public CraftEngineBlockTranslator(JavaPlugin plugin) { this.plugin = plugin; }
+
+    public void start() {
+        plugin.getServer().getPluginManager().registerEvents(this, plugin);
+        rebuild();
+    }
+
+    @EventHandler
+    public void reloaded(CraftEngineReloadEvent event) { rebuild(); }
+
+    @EventHandler
+    public void disabled(PluginDisableEvent event) {
+        if (event.getPlugin().getName().equals("CraftEngine")) mapping = EMPTY;
+    }
+
+    private void rebuild() {
+        int first = BlockStateUtils.vanillaBlockStateCount();
+        int highest = first - 1;
+        for (var block : CraftEngineBlocks.loadedBlocks().values()) {
+            for (var state : block.variantProvider().states()) {
+                highest = Math.max(highest, state.customBlockState().registryId());
+            }
+        }
+        int[] clientIds = new int[highest - first + 1];
+        Arrays.fill(clientIds, -1);
+        int count = 0;
+        for (var block : CraftEngineBlocks.loadedBlocks().values()) {
+            for (var state : block.variantProvider().states()) {
+                int serverId = state.customBlockState().registryId();
+                int clientId = state.visualBlockState().registryId();
+                if (serverId < first || clientId < 0 || clientId >= first) {
+                    throw new IllegalStateException("Invalid CE appearance mapping for " + state);
+                }
+                int index = serverId - first;
+                if (clientIds[index] != -1 && clientIds[index] != clientId) {
+                    throw new IllegalStateException("Conflicting CE appearance for server state " + serverId);
+                }
+                if (clientIds[index] == -1) count++;
+                clientIds[index] = clientId;
+            }
+        }
+        mapping = new Mapping(first, clientIds);
+        plugin.getLogger().info("CraftEngine collision mapping: " + count + " server states to client appearances");
+    }
+
+    @Override
+    public int translate(int serverBlockId) {
+        Mapping current = mapping;
+        if (serverBlockId < current.firstCustomId) return serverBlockId;
+        int index = serverBlockId - current.firstCustomId;
+        if (index >= current.clientIds.length) return serverBlockId;
+        int clientId = current.clientIds[index];
+        return clientId < 0 ? serverBlockId : clientId;
+    }
+
+    @Override
+    public int translateForSimulation(int packetBlockId) { return translate(packetBlockId); }
+
+    @Override
+    public void close() { HandlerList.unregisterAll(this); mapping = EMPTY; }
+}
